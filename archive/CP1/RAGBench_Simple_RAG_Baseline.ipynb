wnloading \"${filename}\": `;\n", "      div.appendChild(label);\n", "      const progress = document.createElement('progress');\n", "      progress.max = size;\n", "      div.appendChild(progress);\n", "      document.body.appendChild(div);\n", "\n", "      const buffers = [];\n", "      let downloaded = 0;\n", "\n", "      const channel = await google.colab.kernel.comms.open(id);\n", "      // Send a message to notify the kernel that we're ready.\n", "      channel.send({})\n", "\n", "      for await (const message of channel.messages) {\n", "        // Send a message to notify the kernel that we're ready.\n", "        channel.send({})\n", "        if (message.buffers) {\n", "          for (const buffer of message.buffers) {\n", "            buffers.push(buffer);\n", "            downloaded += buffer.byteLength;\n", "            progress.value = downloaded;\n", "          }\n", "        }\n", "      }\n", "      const blob = new Blob(buffers, {type: 'application/binary'});\n", "      const a = document.createElement('a');\n", "      a.href = window.URL.createObjectURL(blob);\n", "      a.download = filename;\n", "      div.appendChild(a);\n", "      a.click();\n", "      div.remove();\n", "    }\n", "  "]}, "metadata": {}}, {"output_type": "display_data", "data": {"text/plain": ["<IPython.core.display.Javascript object>"], "application/javascript": ["download(\"download_d42dce92-0103-4009-8d32-6074028c4264\", \"simple_rag_baseline_covidqa.csv\", 30084)"]}, "metadata": {}}, {"output_type": "stream", "name": "stdout", "text": ["\u2705 Download started\n"]}]}, {"cell_type": "code", "source": ["## Save notebook and Push to GitHub\n", "import os\n", "import shutil\n", "\n", "# Create folder structure in repo\n", "os.makedirs('/content/repo/notebooks', exist_ok=True)\n", "os.makedirs('/content/repo/results', exist_ok=True)\n", "\n", "# Copy results CSV\n", "shutil.copy(\n", "    '/content/results/simple_rag_baseline_covidqa.csv',\n", "    '/content/repo/results/simple_rag_baseline_covidqa.csv'\n", ")\n", "\n", "# Find and copy notebook\n", "!find /content -name \"*.ipynb\" -not -path \"*/repo/*\" 2>/dev/null\n", "\n", "# Create results README\n", "with open('/content/repo/results/README.md', 'w') as f:\n", "    f.write(\"\"\"# Results \u2014 Simple RAG Baseline\n", "\n", "## CovidQA Domain (246 examples)\n", "\n", "| Metric | Our Score | Paper GPT-3.5 |\n", "|--------|-----------|---------------|\n", "| Context Relevance RMSE | 0.2410 | 0.18 |\n", "| Context Utilization RMSE | 0.1627 | 0.11 |\n", "| Completeness RMSE | 0.4500 | N/A |\n", "| Adherence AUCROC | 0.6446 | 0.57 |\n", "\n", "**Setup:**\n", "- Dataset: RAGBench CovidQA test split\n", "- Embedding: all-MiniLM-L6-v2\n", "- Retriever: FAISS top-3\n", "- Generator: llama-3.1-8b-instant\n", "- Judge LLM: llama-3.1-8b-instant (RAGBench paper prompt)\n", "- Date: June 2026\n", "\"\"\")\n", "\n", "# Push to GitHub\n", "%cd /content/repo\n", "!git add .\n", "!git status\n", "!git commit -m \"[Veenu] CP-1: Simple RAG baseline results - CovidQA 246 examples - AUCROC:0.6446 better than GPT-3.5\"\n", "!git push origin main\n", "\n", "print()\n", "print(\"\u2705 Pushed to GitHub!\")\n", "print(\"https://github.com/veenulearns-lab/RAGBench-Capstone-Batch26\")"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "hW72gGku2jo2", "executionInfo": {"status": "ok", "timestamp": 1780731386696, "user_tz": -330, "elapsed": 1574, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "4c8f2fba-9711-464d-b090-750b94d967df"}, "execution_count": 39, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["/content/repo\n", "On branch main\n", "Your branch is up to date with 'origin/main'.\n", "\n", "Changes to be committed:\n", "  (use \"git restore --staged <file>...\" to unstage)\n", "\t\u001b[32mnew file:   results/README.md\u001b[m\n", "\n", "[main 1ef267f] [Veenu] CP-1: Simple RAG baseline results - CovidQA 246 examples - AUCROC:0