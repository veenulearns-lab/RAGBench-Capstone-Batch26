version_minor": 0, "model_id": "b422aaa5dce348edb8698c1c7f6e1ee8"}}, "metadata": {}}, {"output_type": "display_data", "data": {"text/plain": ["tokenizer.json:   0%|          | 0.00/466k [00:00<?, ?B/s]"], "application/vnd.jupyter.widget-view+json": {"version_major": 2, "version_minor": 0, "model_id": "a28c7164a75e4812bfecb23cb15cc865"}}, "metadata": {}}, {"output_type": "display_data", "data": {"text/plain": ["special_tokens_map.json:   0%|          | 0.00/112 [00:00<?, ?B/s]"], "application/vnd.jupyter.widget-view+json": {"version_major": 2, "version_minor": 0, "model_id": "55bd29a716ac499db3774ec767545a56"}}, "metadata": {}}, {"output_type": "display_data", "data": {"text/plain": ["config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]"], "application/vnd.jupyter.widget-view+json": {"version_major": 2, "version_minor": 0, "model_id": "ce8c31120f7f42a5ba98b0b9bfdfaacd"}}, "metadata": {}}, {"output_type": "stream", "name": "stdout", "text": ["\u2705 Embedding model loaded\n", "Embedding dimension: 384\n"]}]}, {"cell_type": "code", "source": ["#build retreiver function\n", "def build_retriever(documents):\n", "    \"\"\"\n", "    Given a list of documents, build a FAISS index\n", "    and return a function that retrieves top-k relevant documents\n", "    \"\"\"\n", "    # Embed all documents\n", "    doc_embeddings = embedder.encode(documents, show_progress_bar=False)\n", "    doc_embeddings = np.array(doc_embeddings).astype('float32')\n", "\n", "    # Build FAISS index\n", "    dimension = doc_embeddings.shape[1]\n", "    index = faiss.IndexFlatL2(dimension)\n", "    index.add(doc_embeddings)\n", "\n", "    return index, doc_embeddings\n", "\n", "def retrieve_top_k(question, documents, index, k=3):\n", "    \"\"\"\n", "    For a given question, retrieve top-k relevant documents\n", "    \"\"\"\n", "    # Embed the question\n", "    question_embedding = embedder.encode([question])\n", "    question_embedding = np.array(question_embedding).astype('float32')\n", "\n", "    # Search FAISS index\n", "    distances, indices = index.search(question_embedding, k)\n", "\n", "    # Return top-k documents\n", "    top_k_docs = [documents[i] for i in indices[0]]\n", "\n", "    return top_k_docs\n", "\n", "# Test on first example\n", "example = dataset[0]\n", "documents = example['documents']\n", "question = example['question']\n", "\n", "print(\"Question:\", question)\n", "print()\n", "print(\"Number of documents:\", len(documents))\n", "print()\n", "\n", "# Build retriever for this example\n", "index, doc_embeddings = build_retriever(documents)\n", "\n", "# Retrieve top 3\n", "top_k = retrieve_top_k(question, documents, index, k=3)\n", "\n", "print(\"Top 3 retrieved documents:\")\n", "for i, doc in enumerate(top_k):\n", "    print(f\"\\nDoc {i+1} (first 200 chars):\")\n", "    print(doc[:200])"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "B6KjgbjXMuGW", "executionInfo": {"status": "ok", "timestamp": 1780720266695, "user_tz": -330, "elapsed": 248, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "461027b2-c3b7-4484-dd69-2fe1156c8948"}, "execution_count": 12, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Question: Which viruses may not cause prolonged inflammation due to strong induction of antiviral clearance?\n", "\n", "Number of documents: 4\n", "\n", "Top 3 retrieved documents:\n", "\n", "Doc 1 (first 200 chars):\n", "Title: Type I Interferon Receptor Deficiency in Dendritic Cells Facilitates Systemic Murine Norovirus Persistence Despite Enhanced Adaptive Immunity\n", "Passage: successful treatment for HCV serves to cir\n", "\n", "Doc 2 (first 200 chars):\n", "Title: Immune Mechanisms Responsible for Vaccination against and Clearance of Mucosal and Lymphatic Norovirus Infection\n", "Passage: HuNV infection and disease is rapid, with symptoms developing within 24\n", "\n", "Doc 3 (first 200 chars):\n", "Title: UNC93B1 Mediates Innate Inflammation and Antiviral Defense in the Liver during Acute Murine Cytomegalovirus Infection\n", "Passage: 4-fold fewer PDCA-1+ pDCs expressing intracellular IFN-a at 40 h, \n"]}]}, {"cell_type": "code", "source": ["#generate responses using groqLLM\n", "from groq import Groq\n", "\n", "client = Groq(api_key=os.environ[\"GROQ_API_KEY\"])\n", "\n", "def generate_response(question, retrieved_docs):\n", "    \"\"\"\n", "    Given a question and retrieved documents,\n", "    generate a response using Groq LLM\n", "    \"\"\"\n", "    # Combine documents into context\n", "    context = \"\\n\\n\".join([f\"Document {i+1}:\\n{doc}\"\n", "                           for i, doc in enumerate(retrieved_docs)])\n", "\n", "    # Build prompt\n", "    prompt = f\"\"\"You are a helpful assistant. Answer the question based only on the provided documents.\n", "Be concise and factual. If the answer is not in the documents, say so.\n", "\n", "Documents:\n", "{context}\n", "\n", "Question: {question}\n", "\n", "Answer:\"\"\"\n", "\n", "    # Call Groq LLM\n", "    response = client.chat.completions.create(\n", "        model=\"llama-3.1-8b-instant\",\n", "        messages=[{\"role\": \"user\", \"content\": prompt}],\n", "        max_tokens=256,\n", "        temperature=0\n", "    )\n", "\n", "    return response.choices[0].message.content.strip()\n", "\n", "# Test on first example\n", "example = dataset[0]\n", "question = example['question']\n", "documents = example['documents']\n", "\n", "# Build retriever and get top 3\n", "index, doc_embeddings = build_retriever(documents)\n", "top_k_docs = retrieve_top_k(question, documents, index, k=3)\n", "\n", "# Generate response\n", "print(\"Generating response...\")\n", "our_response = generate_response(question, top_k_docs)\n", "\n", "print(\"=\" * 60)\n", "print(\"QUESTION:\")\n", "print(question)\n", "print()\n", "print(\"OUR RESPONSE:\")\n", "print(our_response)\n", "print()\n", "print(\"REFERENCE RESPONSE:\")\n", "print(example['response'])"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "LzjBnlO5M7ZH", "executionInfo": {"status": "ok", "timestamp": 1780720342226, "user_tz": -330, "elapsed": 701, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "34218c15-c4b3-454f-ba18-bb377a565b07"}, "execution_count": 13, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Generating response...\n", "============================================================\n", "QUESTION:\n", "Which viruses may not cause prolonged inflammation due to strong induction of antiviral clearance?\n", "\n", "OUR RESPONSE:\n", "The documents do not provide a direct answer to the question. However, they do mention that certain viruses may persist due to ineffective innate responses (Document 1). \n", "\n", "The viruses mentioned in Document 1 that may persist due to ineffective innate responses are:\n", "\n", "1. HCV (Hepatitis C Virus)\n", "2. Chikungunya\n", "3. Measles\n", "4. Polyomavirus\n", "\n", "These viruses may not cause prolonged inflammation due to strong induction of antiviral clearance, as their persistence is attributed to ineffective innate immune function.\n", "\n", "REFERENCE RESPONSE:\n", "The viruses that may not cause prolonged inflammation due to strong induction of antiviral clearance are murine norovirus, human astrovirus, and murine cytomegalovirus.\n"]}]}, {"cell_type": "code", "source": ["#Judge LLM prompt\n", "import json\n", "\n", "def run_judge_llm(question, retrieved_docs, response):\n", "    \"\"\"\n", "    Run Judge LLM to get 6 attributes needed for TRACe metrics\n", "    as specified in the RAGBench paper\n", "    \"\"\"\n", "    # Format documents with sentence keys\n", "    formatted_docs = \"\"\n", "    all_sentence_keys = []\n", "\n", "    for doc_idx, doc in enumerate(retrieved_docs):\n", "        sentences = doc.split('. ')\n", "        formatted_docs += f\"\\nDocument {doc_idx}:\\n\"\n", "        for sent_idx, sent in enumerate(sentences):\n", "            key = f\"{doc_idx}{chr(97 + sent_idx)}\"  # 0a, 0b, 0c etc\n", "            all_sentence_keys.append(key)\n", "            formatted_docs += f\"[{key}] {sent.strip()}\\n\"\n", "\n", "    # Format response with sentence keys\n", "    formatted_response = \"\"\n", "    response_sentences = response.split('. ')\n", "    for sent_idx, sent in enumerate(response_sentences):\n", "        key = chr(97 + sent_idx)  # a, b, c etc\n", "        formatted_response += f\"[{key}] {sent.strip()}\\n\"\n", "\n", "    # Judge LLM prompt based on RAGBench paper\n", "    prompt = f\"\"\"You are an expert evaluator for RAG systems.\n", "Analyze the following question, context documents, and response.\n", "\n", "QUESTION: {question}\n", "\n", "CONTEXT DOCUMENTS (each sentence has a key like [0a], [0b], [1a] etc):\n", "{formatted_docs}\n", "\n", "RESPONSE (each sentence has a key like [a], [b] etc):\n", "{formatted_response}\n", "\n", "Evaluate and return a JSON object with exactly these fields:\n", "{{\n", "    \"relevance_explanation\": \"explanation of which document sentences are relevant to the question\",\n", "    \"all_relevant_sentence_keys\": [\"list\", \"of\", \"relevant\", \"sentence\", \"keys\", \"from\", \"documents\"],\n", "    \"overall_supported_explanation\": \"explanation of whether response is supported by documents\",\n", "    \"overall_supported\": true or false,\n", "    \"sentence_support_information\": [\n", "        {{\n", "            \"response_sentence_key\": \"a\",\n", "            \"fully_supported\": true or false,\n", "            \"supporting_sentence_keys\": [\"list of document sentence keys that support this response sentence\"],\n", "            \"explanation\": \"explanation\"\n", "        }}\n", "    ],\n", "    \"all_utilized_sentence_keys\": [\"list\", \"of\", \"document\", \"sentence\", \"keys\", \"actually\", \"used\", \"in\", \"response\"]\n", "}}\n", "\n", "Return ONLY the JSON object. No other text.\"\"\"\n", "\n", "    response_judge = client.chat.completions.create(\n", "        model=\"llama-3.1-8b-instant\",\n", "        messages=[{\"role\": \"user\", \"content\": prompt}],\n", "        max_tokens=1024,\n", "        temperature=0\n", "    )\n", "\n", "    # Parse JSON response\n", "    raw = response_judge.choices[0].message.content.strip()\n", "\n", "    # Clean up in case LLM adds markdown\n", "    if \"```json\" in raw:\n", "        raw = raw.split(\"```json\")[1].split(\"```\")[0].strip()\n", "    elif \"```\" in raw:\n", "        raw = raw.split(\"```\")[1].split(\"```\")[0].strip()\n", "\n", "    try:\n", "        result = json.loads(raw)\n", "        return result, all_sentence_keys\n", "    except json.JSONDecodeError:\n", "        print(\"JSON parsing failed. Raw output:\")\n", "        print(raw[:500])\n", "        return None, all_sentence_keys\n", "\n", "# Test on first example\n", "example = dataset[0]\n", "question = example['question']\n", "documents = example['documents']\n", "\n", "index, doc_embeddings = build_retriever(documents)\n", "top_k_docs = retrieve_top_k(question, documents, index, k=3)\n", "our_response = generate_response(question, top_k_docs)\n", "\n", "print(\"Running Judge LLM...\")\n", "judge_output, all_keys = run_judge_llm(question, top_k_docs, our_response)\n", "\n", "print(\"\u2705 Judge LLM output:\")\n", "print(json.dumps(judge_output, indent=2))"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "Qm6qraPMNPS6", "executionInfo": {"status": "ok", "timestamp": 1780720411525, "user_tz": -330, "elapsed": 1615, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "1d4bc939-3aba-42ce-d38c-af4a764c4eb8"}, "execution_count": 14, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Running Judge LLM...\n", "\u2705 Judge LLM output:\n", "{\n", "  \"relevance_explanation\": \"Document 0 mentions that HCV may persist due to loss of innate immune function, and Document 1 mentions that certain viruses may persist due to ineffective innate responses. Document 2 discusses the role of UNC93B1 in innate inflammation and antiviral defense, but does not directly address the question.\",\n", "  \"all_relevant_sentence_keys\": [\n", "    \"0b\",\n", "    \"1b\",\n", "    \"2a\",\n", "    \"2b\"\n", "  ],\n", "  \"overall_supported_explanation\": \"The response is partially supported by the documents, as they mention that certain viruses may persist due to ineffective innate responses, but do not directly address the relationship between antiviral clearance and prolonged inflammation.\",\n", "  \"overall_supported\": false,\n", "  \"sentence_support_information\": [\n", "    {\n", "      \"response_sentence_key\": \"a\",\n", "      \"fully_supported\": true,\n", "      \"supporting_sentence_keys\": [\n", "        \"0a\",\n", "        \"0b\",\n", "        \"1b\",\n", "        \"2a\",\n", "        \"2b\"\n", "      ],\n", "      \"explanation\": \"The documents do not provide a direct answer to the question, but they do provide relevant information about viral persistence and innate immune function.\"\n", "    },\n", "    {\n", "      \"response_sentence_key\": \"b\",\n", "      \"fully_supported\": false,\n", "      \"supporting_sentence_keys\": [\n", "        \"1b\"\n", "      ],\n", "      \"explanation\": \"Document 1 mentions that certain viruses may persist due to ineffective innate responses, but does not directly address the relationship between antiviral clearance and prolonged inflammation.\"\n", "    },\n", "    {\n", "      \"response_sentence_key\": \"c\",\n", "      \"fully_supported\": false,\n", "      \"supporting_sentence_keys\": [\n", "        \"1b\"\n", "      ],\n", "      \"explanation\": \"Document 1 mentions that certain viruses may persist due to ineffective innate responses, but does not provide a list of specific viruses that may not cause prolonged inflammation due to strong induction of antiviral clearance.\"\n", "    },\n", "    {\n", "      \"response_sentence_key\": \"d\",\n", "      \"fully_supported\": false,\n", "      \"supporting_sentence_keys\": [\n", "        \"0b\"\n", "      ],\n", "      \"explanation\": \"Document 0 mentions that HCV may persist due to loss of innate immune function, but does not directly address the relationship between antiviral clearance and prolonged inflammation.\"\n", "    },\n", "    {\n", "      \"response_sentence_key\": \"e\",\n", "      \"fully_supported\": false,\n", "      \"supporting_sentence_keys\": [\n", "        \"0c\"\n", "      ],\n", "      \"explanation\": \"Document 0 mentions that other continuously replicating RNA viruses may persist due to ineffective innate responses, but does not provide a list of specific viruses that may not cause prolonged inflammation due to strong induction of antiviral clearance.\"\n", "    },\n", "    {\n", "      \"response_sentence_key\": \"f\",\n", "      \"fully_supported\": false,\n", "      \"supporting_sentence_keys\": [\n", "        \"0c\"\n", "      ],\n", "      \"explanation\": \"Document 0 mentions that other continuously replicating RNA viruses may persist due to ineffective innate responses, but does not provide a list of specific viruses that may not cause prolonged inflammation due to strong induction of antiviral clearance.\"\n", "    },\n", "    {\n", "      \"response_sentence_key\": \"g\",\n", "      \"fully_supported\": false,\n", "      \"supporting_sentence_keys\": [\n", "        \"0c\"\n", "      ],\n", "      \"explanation\": \"Document 0 mentions that other continuously replicating RNA viruses may persist due to ineffective innate responses, but does not provide a list of specific viruses that may not cause prolonged inflammation due to strong induction of antiviral clearance.\"\n", "    }\n", "  ],\n", "  \"all_utilized_sentence_keys\": [\n", "    \"0a\",\n", "    \"0b\",\n", "    \"0c\",\n", "    \"1a\",\n", "    \"1b\",\n", "    \"1c\",\n", "    \"1d\",\n", "    \"2a\",\n", "    \"2b\"\n", "  ]\n", "}\n"]}]}, {"cell_type": "code", "source": ["# Compute TRACe metrics\n", "def compute_trace_metrics(judge_output, all_sentence_keys):\n", "    \"\"\"\n", "    Compute TRACe metrics from Judge LLM output\n", "    Based on RAGBench paper formulas\n", "    \"\"\"\n", "\n", "    # \u2500\u2500 METRIC 1: CONTEXT RELEVANCE \u2500\u2500\n", "    # Formula: number of relevant sentences / total document sentences\n", "    all_relevant = judge_output.get('all_relevant_sentence_keys', [])\n", "    total_sentences = len(all_sentence_keys)\n", "\n", "    if total_sentences > 0:\n", "        context_relevance = len(all_relevant) / total_sentences\n", "    else:\n", "        context_relevance = 0.0\n", "\n", "    # \u2500\u2500 METRIC 2: CONTEXT UTILIZATION \u2500\u2500\n", "    # Formula: number of utilized sentences / total document sentences\n", "    all_utilized = judge_output.get('all_utilized_sentence_keys', [])\n", "\n", "    if total_sentences > 0:\n", "        context_utilization = len(all_utilized) / total_sentences\n", "    else:\n", "        context_utilization = 0.0\n", "\n", "    # \u2500\u2500 METRIC 3: COMPLETENESS \u2500\u2500\n", "    # Formula: number of relevant sentences utilized / total relevant sentences\n", "    if len(all_relevant) > 0:\n", "        relevant_and_utilized = set(all_relevant) & set(all_utilized)\n", "        completeness = len(relevant_and_utilized) / len(all_relevant)\n", "    else:\n", "        completeness = 0.0\n", "\n", "    # \u2500\u2500 METRIC 4: ADHERENCE \u2500\u2500\n", "    # Formula: True if all response sentences are fully supported\n", "    sentence_support = judge_output.get('sentence_support_information', [])\n", "\n", "    if len(sentence_support) > 0:\n", "        all_supported = all(\n", "            s.get('fully_supported', False)\n", "            for s in sentence_support\n", "        )\n", "        adherence = all_supported\n", "    else:\n", "        adherence = judge_output.get('overall_supported', False)\n", "\n", "    return {\n", "        'context_relevance': round(context_relevance, 4),\n", "        'context_utilization': round(context_utilization, 4),\n", "        'completeness': round(completeness, 4),\n", "        'adherence': adherence\n", "    }\n", "\n", "# Compute metrics for first example\n", "our_metrics = compute_trace_metrics(judge_output, all_keys)\n", "\n", "print(\"=\" * 60)\n", "print(\"OUR COMPUTED TRACe METRICS vs REFERENCE SCORES\")\n", "print(\"=\" * 60)\n", "print(f\"{'Metric':<25} {'Ours':>10} {'Reference':>12}\")\n", "print(\"-\" * 50)\n", "print(f\"{'Context Relevance':<25} {our_metrics['context_relevance']:>10.4f} {example['relevance_score']:>12.4f}\")\n", "print(f\"{'Context Utilization':<25} {our_metrics['context_utilization']:>10.4f} {example['utilization_score']:>12.4f}\")\n", "print(f\"{'Completeness':<25} {our_metrics['completeness']:>10.4f} {example['completeness_score']:>12.4f}\")\n", "print(f\"{'Adherence':<25} {str(our_metrics['adherence']):>10} {str(example['adherence_score']):>12}\")\n", "print()\n", "print(\"Note: Differences are expected at this stage.\")\n", "print(\"We will measure RMSE and AUCROC across all 246 examples.\")"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "lRiaoF1JNa1n", "executionInfo": {"status": "ok", "timestamp": 1780720456133, "user_tz": -330, "elapsed": 59, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "6d9276d5-757c-46c7-f77e-19881b8b0d53"}, "execution_count": 15, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["============================================================\n", "OUR COMPUTED TRACe METRICS vs REFERENCE SCORES\n", "============================================================\n", "Metric                          Ours    Reference\n", "--------------------------------------------------\n", "Context Relevance             0.4444       0.4118\n", "Context Utilization           1.0000       0.1765\n", "Completeness                  1.0000       0.4286\n", "Adherence                      False        False\n", "\n", "Note: Differences are expected at this stage.\n", "We will measure RMSE and AUCROC across all 246 examples.\n"]}]}, {"cell_type": "code", "source": ["#huge difference. Why? Our sentence keying is different from the reference. We split documents by .\n", " #(period + space) which creates different sentence boundaries than the reference dataset.\n", " #Our Judge LLM returned 9 utilized keys out of 9 total \u2014 because our sentence splitting created fewer, longer sentences.\n", " #The reference has more granular sentence keys."], "metadata": {"id": "r37u2SVsNxnQ"}, "execution_count": null, "outputs": []}, {"cell_type": "code", "source": ["# Fix sentence keying using dataset's own sentence structure\n", "def build_retriever_with_sentences(documents, documents_sentences):\n", "    \"\"\"\n", "    Build retriever using pre-split sentences from dataset\n", "    Returns documents, sentence map, and all sentence keys\n", "    \"\"\"\n", "    # Build sentence key map from dataset\n", "    # documents_sentences is a list of lists: [[key, sentence], ...]\n", "    sentence_map = {}  # key -> sentence text\n", "    all_sentence_keys = []\n", "\n", "    for doc_sentences in documents_sentences:\n", "        for key, sentence in doc_sentences:\n", "            sentence_map[key] = sentence\n", "            all_sentence_keys.append(key)\n", "\n", "    return sentence_map, all_sentence_keys\n", "\n", "def run_judge_llm_v2(question, retrieved_docs,\n", "                      documents_sentences, response):\n", "    \"\"\"\n", "    Run Judge LLM using proper sentence keys from dataset\n", "    \"\"\"\n", "    # Build formatted docs using dataset sentence keys\n", "    formatted_docs = \"\"\n", "    all_sentence_keys = []\n", "\n", "    # Only use sentences from retrieved docs\n", "    # Find which doc indices were retrieved\n", "    retrieved_indices = []\n", "    all_docs = retrieved_docs\n", "\n", "    for doc_idx, doc_sentences in enumerate(documents_sentences):\n", "        # Check if this document was retrieved\n", "        doc_text = \"\"\n", "        for key, sent in doc_sentences:\n", "            doc_text += sent + \" \"\n", "\n", "        # Add all sentences with their original keys\n", "        formatted_docs += f\"\\nDocument {doc_idx}:\\n\"\n", "        for key, sentence in doc_sentences:\n", "            all_sentence_keys.append(key)\n", "            formatted_docs += f\"[{key}] {sentence}\\n\"\n", "\n", "    # Format response sentences\n", "    formatted_response = \"\"\n", "    response_sents = response.replace('. ', '.|').split('|')\n", "    for sent_idx, sent in enumerate(response_sents):\n", "        if sent.strip():\n", "            key = chr(97 + sent_idx)\n", "            formatted_response += f\"[{key}] {sent.strip()}\\n\"\n", "\n", "    prompt = f\"\"\"You are an expert evaluator for RAG systems.\n", "Analyze the question, context documents, and response carefully.\n", "\n", "QUESTION: {question}\n", "\n", "CONTEXT DOCUMENTS (each sentence labeled with key like [0a], [0b]):\n", "{formatted_docs}\n", "\n", "RESPONSE (each sentence labeled with key like [a], [b]):\n", "{formatted_response}\n", "\n", "Return a JSON object with exactly these fields:\n", "{{\n", "    \"relevance_explanation\": \"which document sentences are relevant to the question and why\",\n", "    \"all_relevant_sentence_keys\": [\"keys of ALL document sentences relevant to the question\"],\n", "    \"overall_supported_explanation\": \"is the response supported by the documents?\",\n", "    \"overall_supported\": true or false,\n", "    \"sentence_support_information\": [\n", "        {{\n", "            \"response_sentence_key\": \"a\",\n", "            \"fully_supported\": true or false,\n", "            \"supporting_sentence_keys\": [\"document sentence keys that support this response sentence\"],\n", "            \"explanation\": \"brief explanation\"\n", "        }}\n", "    ],\n", "    \"all_utilized_sentence_keys\": [\"document sentence keys that were actually used to generate the response\"]\n", "}}\n", "\n", "Important:\n", "- all_relevant_sentence_keys: which document sentences contain information relevant to the question\n", "- all_utilized_sentence_keys: which document sentences were actually used in generating the response\n", "- Be precise with sentence keys - use only keys that appear in the documents above\n", "\n", "Return ONLY valid JSON. No markdown, no extra text.\"\"\"\n", "\n", "    response_judge = client.chat.completions.create(\n", "        model=\"llama-3.1-8b-instant\",\n", "        messages=[{\"role\": \"user\", \"content\": prompt}],\n", "        max_tokens=1024,\n", "        temperature=0\n", "    )\n", "\n", "    raw = response_judge.choices[0].message.content.strip()\n", "\n", "    if \"```json\" in raw:\n", "        raw = raw.split(\"```json\")[1].split(\"```\")[0].strip()\n", "    elif \"```\" in raw:\n", "        raw = raw.split(\"```\")[1].split(\"```\")[0].strip()\n", "\n", "    try:\n", "        result = json.loads(raw)\n", "        return result, all_sentence_keys\n", "    except json.JSONDecodeError:\n", "        print(\"JSON parse failed. Raw:\")\n", "        print(raw[:300])\n", "        return None, all_sentence_keys\n", "\n", "# Test on first example with fixed sentence keying\n", "example = dataset[0]\n", "question = example['question']\n", "documents = example['documents']\n", "documents_sentences = example['documents_sentences']\n", "\n", "# Build retriever\n", "index, doc_embeddings = build_retriever(documents)\n", "top_k_docs = retrieve_top_k(question, documents, index, k=3)\n", "\n", "# Generate response\n", "our_response = generate_response(question, top_k_docs)\n", "\n", "# Run Judge LLM with proper sentence keys\n", "print(\"Running Judge LLM v2 with proper sentence keys...\")\n", "judge_output_v2, all_keys_v2 = run_judge_llm_v2(\n", "    question, top_k_docs, documents_sentences, our_response\n", ")\n", "\n", "# Compute metrics\n", "our_metrics_v2 = compute_trace_metrics(judge_output_v2, all_keys_v2)\n", "\n", "print()\n", "print(\"=\" * 60)\n", "print(\"FIXED TRACe METRICS vs REFERENCE SCORES\")\n", "print(\"=\" * 60)\n", "print(f\"{'Metric':<25} {'Ours':>10} {'Reference':>12}\")\n", "print(\"-\" * 50)\n", "print(f\"{'Context Relevance':<25} {our_metrics_v2['context_relevance']:>10.4f} {example['relevance_score']:>12.4f}\")\n", "print(f\"{'Context Utilization':<25} {our_metrics_v2['context_utilization']:>10.4f} {example['utilization_score']:>12.4f}\")\n", "print(f\"{'Completeness':<25} {our_metrics_v2['completeness']:>10.4f} {example['completeness_score']:>12.4f}\")\n", "print(f\"{'Adherence':<25} {str(our_metrics_v2['adherence']):>10} {str(example['adherence_score']):>12}\")\n", "print()\n", "print(\"All sentence keys used:\", all_keys_v2[:10], \"...\")\n", "print(\"Total sentence keys:\", len(all_keys_v2))\n", "print(\"Reference total sentences:\",\n", "      sum(len(d) for d in documents_sentences))"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "bWOJwe0mN8qd", "executionInfo": {"status": "ok", "timestamp": 1780720595517, "user_tz": -330, "elapsed": 1620, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "4f48e676-47ca-4ca8-ba03-76536699c99b"}, "execution_count": 16, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Running Judge LLM v2 with proper sentence keys...\n", "\n", "============================================================\n", "FIXED TRACe METRICS vs REFERENCE SCORES\n", "============================================================\n", "Metric                          Ours    Reference\n", "--------------------------------------------------\n", "Context Relevance             0.4118       0.4118\n", "Context Utilization           0.4706       0.1765\n", "Completeness                  1.0000       0.4286\n", "Adherence                      False        False\n", "\n", "All sentence keys used: ['0a', '0b', '0c', '0d', '1a', '1b', '1c', '1d', '1e', '2a'] ...\n", "Total sentence keys: 17\n", "Reference total sentences: 17\n"]}]}, {"cell_type": "code", "source": ["#Note\n", "Context Relevance: 0.4118 vs 0.4118 \u2014 PERFECT MATCH! \u2705\n", "Adherence: False vs False \u2014 PERFECT MATCH! \u2705\n", "Context Utilization: 0.4706 vs 0.1765 \u2014 still different. The Judge LLM is marking too many sentences as utilized. This is a prompt tuning issue we will fix.\n", "Completeness: 1.00 vs 0.43 \u2014 same issue. Too many relevant sentences being marked as utilized.\n", "\n", "This is great progress for one session. Context Relevance is now perfectly matching the reference. Let's fix Utilization and Completeness next.\n", "\n", "The problem with Utilization and Completeness\n", "The reference dataset considers a sentence \"utilized\" only if it was directly and specifically used to construct the response. Our Judge LLM is being too generous \u2014 marking sentences as utilized even when they were only loosely related."], "metadata": {"id": "AEVFkuLbOLYU"}, "execution_count": null, "outputs": []}, {"cell_type": "code", "source": ["#Enhance the Judge LLM prompt for Utilization\n", "def run_judge_llm_v3(question, retrieved_docs,\n", "                      documents_sentences, response):\n", "    \"\"\"\n", "    Tighter Judge LLM prompt - stricter utilization criteria\n", "    \"\"\"\n", "    # Build formatted docs using dataset sentence keys\n", "    formatted_docs = \"\"\n", "    all_sentence_keys = []\n", "\n", "    for doc_idx, doc_sentences in enumerate(documents_sentences):\n", "        formatted_docs += f\"\\nDocument {doc_idx}:\\n\"\n", "        for key, sentence in doc_sentences:\n", "            all_sentence_keys.append(key)\n", "            formatted_docs += f\"[{key}] {sentence}\\n\"\n", "\n", "    # Format response sentences\n", "    formatted_response = \"\"\n", "    response_sents = response.replace('. ', '.|').split('|')\n", "    resp_keys = []\n", "    for sent_idx, sent in enumerate(response_sents):\n", "        if sent.strip():\n", "            key = chr(97 + sent_idx)\n", "            resp_keys.append(key)\n", "            formatted_response += f\"[{key}] {sent.strip()}\\n\"\n", "\n", "    prompt = f\"\"\"You are a strict RAG evaluation expert.\n", "\n", "QUESTION: {question}\n", "\n", "CONTEXT DOCUMENTS:\n", "{formatted_docs}\n", "\n", "RESPONSE:\n", "{formatted_response}\n", "\n", "Your task is to carefully evaluate the response against the documents.\n", "\n", "Definitions:\n", "- RELEVANT sentence: a document sentence that contains information DIRECTLY needed to answer the question\n", "- UTILIZED sentence: a document sentence whose specific content was DIRECTLY used to write the response. Must have clear textual evidence in the response.\n", "- SUPPORTED sentence: a response sentence where EVERY factual claim can be traced to a specific document sentence\n", "\n", "Be STRICT:\n", "- Only mark a document sentence as relevant if it directly addresses the question\n", "- Only mark a document sentence as utilized if specific information from it appears in the response\n", "- Only mark a response sentence as fully_supported if ALL its claims are in the documents\n", "\n", "Return ONLY this JSON:\n", "{{\n", "    \"relevance_explanation\": \"brief explanation of relevant sentences\",\n", "    \"all_relevant_sentence_keys\": [\"only keys of document sentences DIRECTLY relevant to question\"],\n", "    \"overall_supported_explanation\": \"brief explanation\",\n", "    \"overall_supported\": true or false,\n", "    \"sentence_support_information\": [\n", "        {{\n", "            \"response_sentence_key\": \"a\",\n", "            \"fully_supported\": true or false,\n", "            \"supporting_sentence_keys\": [\"document keys with DIRECT evidence for this response sentence\"],\n", "            \"explanation\": \"brief explanation\"\n", "        }}\n", "    ],\n", "    \"all_utilized_sentence_keys\": [\"only document keys whose SPECIFIC content appears in the response\"]\n", "}}\n", "\n", "Return ONLY valid JSON.\"\"\"\n", "\n", "    response_judge = client.chat.completions.create(\n", "        model=\"llama-3.1-8b-instant\",\n", "        messages=[{\"role\": \"user\", \"content\": prompt}],\n", "        max_tokens=1024,\n", "        temperature=0\n", "    )\n", "\n", "    raw = response_judge.choices[0].message.content.strip()\n", "\n", "    if \"```json\" in raw:\n", "        raw = raw.split(\"```json\")[1].split(\"```\")[0].strip()\n", "    elif \"```\" in raw:\n", "        raw = raw.split(\"```\")[1].split(\"```\")[0].strip()\n", "\n", "    try:\n", "        result = json.loads(raw)\n", "        return result, all_sentence_keys\n", "    except json.JSONDecodeError:\n", "        print(\"JSON parse failed. Raw:\")\n", "        print(raw[:300])\n", "        return None, all_sentence_keys\n", "\n", "# Test v3\n", "example = dataset[0]\n", "question = example['question']\n", "documents = example['documents']\n", "documents_sentences = example['documents_sentences']\n", "\n", "index, doc_embeddings = build_retriever(documents)\n", "top_k_docs = retrieve_top_k(question, documents, index, k=3)\n", "our_response = generate_response(question, top_k_docs)\n", "\n", "print(\"Running Judge LLM v3 (stricter)...\")\n", "judge_output_v3, all_keys_v3 = run_judge_llm_v3(\n", "    question, top_k_docs, documents_sentences, our_response\n", ")\n", "\n", "our_metrics_v3 = compute_trace_metrics(judge_output_v3, all_keys_v3)\n", "\n", "print()\n", "print(\"=\" * 60)\n", "print(\"V3 METRICS vs REFERENCE SCORES\")\n", "print(\"=\" * 60)\n", "print(f\"{'Metric':<25} {'Ours v3':>10} {'Reference':>12}\")\n", "print(\"-\" * 50)\n", "print(f\"{'Context Relevance':<25} {our_metrics_v3['context_relevance']:>10.4f} {example['relevance_score']:>12.4f}\")\n", "print(f\"{'Context Utilization':<25} {our_metrics_v3['context_utilization']:>10.4f} {example['utilization_score']:>12.4f}\")\n", "print(f\"{'Completeness':<25} {our_metrics_v3['completeness']:>10.4f} {example['completeness_score']:>12.4f}\")\n", "print(f\"{'Adherence':<25} {str(our_metrics_v3['adherence']):>10} {str(example['adherence_score']):>12}\")\n", "print()\n", "print(\"Judge output utilized keys:\",\n", "      judge_output_v3.get('all_utilized_sentence_keys', []))\n", "print(\"Reference utilized keys:\",\n", "      example['all_utilized_sentence_keys'])"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "FSD4Ua1YOOWE", "executionInfo": {"status": "ok", "timestamp": 1780720680915, "user_tz": -330, "elapsed": 1577, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "a117af34-94bb-4083-e774-4106f8c280dd"}, "execution_count": 17, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Running Judge LLM v3 (stricter)...\n", "\n", "============================================================\n", "V3 METRICS vs REFERENCE SCORES\n", "============================================================\n", "Metric                       Ours v3    Reference\n", "--------------------------------------------------\n", "Context Relevance             0.2353       0.4118\n", "Context Utilization           1.0000       0.1765\n", "Completeness                  1.0000       0.4286\n", "Adherence                      False        False\n", "\n", "Judge output utilized keys: ['0a', '0b', '0c', '0d', '1a', '1b', '1c', '1d', '1e', '2a', '2b', '2c', '3a', '3b', '3c', '3d', '3e']\n", "Reference utilized keys: ['0c', '1b', '2b']\n"]}]}, {"cell_type": "code", "source": ["#exact RAGBench paper prompt + stronger LLM\n", "import json\n", "from groq import Groq\n", "\n", "client = Groq(api_key=os.environ[\"GROQ_API_KEY\"])\n", "\n", "def format_documents_with_keys(documents_sentences):\n", "    \"\"\"\n", "    Format documents exactly as RAGBench paper expects:\n", "    Each sentence on its own line with its key like '0a.' or '1b.'\n", "    \"\"\"\n", "    formatted = \"\"\n", "    for doc_sentences in documents_sentences:\n", "        for key, sentence in doc_sentences:\n", "            formatted += f\"{key}. {sentence}\\n\"\n", "        formatted += \"\\n\"\n", "    return formatted.strip()\n", "\n", "def format_response_with_keys(response):\n", "    \"\"\"\n", "    Format response exactly as RAGBench paper expects:\n", "    Each sentence on its own line with key like 'a.' or 'b.'\n", "    \"\"\"\n", "    # Split into sentences carefully\n", "    import re\n", "    sentences = re.split(r'(?<=[.!?])\\s+', response.strip())\n", "    sentences = [s.strip() for s in sentences if s.strip()]\n", "\n", "    formatted = \"\"\n", "    for idx, sentence in enumerate(sentences):\n", "        key = chr(97 + idx)  # a, b, c ...\n", "        formatted += f\"{key}. {sentence}\\n\"\n", "\n", "    return formatted.strip(), [chr(97 + i) for i in range(len(sentences))]\n", "\n", "def run_judge_llm_paper(question, documents_sentences, response):\n", "    \"\"\"\n", "    Exact RAGBench paper prompt template\n", "    Using llama-3.3-70b-versatile \u2014 much stronger model\n", "    \"\"\"\n", "    # Format documents and response exactly as paper specifies\n", "    formatted_docs = format_documents_with_keys(documents_sentences)\n", "    formatted_response, response_keys = format_response_with_keys(response)\n", "\n", "    # Get all sentence keys\n", "    all_sentence_keys = []\n", "    for doc_sentences in documents_sentences:\n", "        for key, sentence in doc_sentences:\n", "            all_sentence_keys.append(key)\n", "\n", "    # Exact prompt from RAGBench paper Appendix 7.4\n", "    prompt = f\"\"\"I asked someone to answer a question based on one or more documents.\n", "Your task is to review their response and assess whether or not each sentence\n", "in that response is supported by text in the documents. And if so, which\n", "sentences in the documents provide that support. You will also tell me which\n", "of the documents contain useful information for answering the question, and\n", "which of the documents the answer was sourced from.\n", "\n", "Here are the documents, each of which is split into sentences. Alongside each\n", "sentence is associated key, such as '0a.' or '0b.' that you can use to refer\n", "to it:\n", "'''\n", "{formatted_docs}\n", "'''\n", "\n", "The question was:\n", "'''\n", "{question}\n", "'''\n", "\n", "Here is their response, split into sentences. Alongside each sentence is\n", "associated key, such as 'a.' or 'b.' that you can use to refer to it. Note\n", "that these keys are unique to the response, and are not related to the keys\n", "in the documents:\n", "'''\n", "{formatted_response}\n", "'''\n", "\n", "You must respond with a JSON object matching this schema:\n", "'''\n", "{{\n", "\"relevance_explanation\": string,\n", "\"all_relevant_sentence_keys\": [string],\n", "\"overall_supported_explanation\": string,\n", "\"overall_supported\": boolean,\n", "\"sentence_support_information\": [\n", "{{\n", "\"response_sentence_key\": string,\n", "\"explanation\": string,\n", "\"supporting_sentence_keys\": [string],\n", "\"fully_supported\": boolean\n", "}}\n", "],\n", "\"all_utilized_sentence_keys\": [string]\n", "}}\n", "'''\n", "\n", "The relevance_explanation field is a string explaining which documents\n", "contain useful information for answering the question.\n", "\n", "The all_relevant_sentence_keys field is a list of all document sentence keys\n", "that are relevant to the question. Include every sentence useful and relevant\n", "to the question. Ignore the provided response when making this judgement.\n", "Omit sentences that would not impact someone's ability to answer the question.\n", "\n", "The overall_supported field is a boolean indicating whether the response as a\n", "whole is supported by the documents.\n", "\n", "In sentence_support_information, provide one object for each sentence in the\n", "response. If the sentence is not supported, supporting_sentence_keys MUST be\n", "empty. If fully_supported is false, supporting_sentence_keys must be empty.\n", "\n", "The all_utilized_sentence_keys field is a list of all document sentence keys\n", "that were used to construct the answer. Include every sentence that directly\n", "or implicitly supported the answer. Omit sentences that could have been\n", "removed without affecting the answer.\n", "\n", "You must respond with a valid JSON string. Do not write anything before or\n", "after the JSON string. Do not wrap in backticks.\"\"\"\n", "\n", "    response_judge = client.chat.completions.create(\n", "        model=\"llama-3.3-70b-versatile\",\n", "        messages=[{\"role\": \"user\", \"content\": prompt}],\n", "        max_tokens=2048,\n", "        temperature=0\n", "    )\n", "\n", "    raw = response_judge.choices[0].message.content.strip()\n", "\n", "    # Clean any accidental markdown\n", "    if \"```json\" in raw:\n", "        raw = raw.split(\"```json\")[1].split(\"```\")[0].strip()\n", "    elif \"```\" in raw:\n", "        raw = raw.split(\"```\")[1].split(\"```\")[0].strip()\n", "\n", "    try:\n", "        result = json.loads(raw)\n", "        return result, all_sentence_keys\n", "    except json.JSONDecodeError as e:\n", "        print(\"JSON parse failed:\", e)\n", "        print(\"Raw output (first 500 chars):\")\n", "        print(raw[:500])\n", "        return None, all_sentence_keys\n", "\n", "# Test on first example\n", "example = dataset[0]\n", "question = example['question']\n", "documents = example['documents']\n", "documents_sentences = example['documents_sentences']\n", "\n", "# Build retriever and generate response\n", "index, _ = build_retriever(documents)\n", "top_k_docs = retrieve_top_k(question, documents, index, k=3)\n", "our_response = generate_response(question, top_k_docs)\n", "\n", "print(\"Running Judge LLM with exact RAGBench paper prompt...\")\n", "print(\"Using llama-3.3-70b-versatile...\")\n", "print()\n", "\n", "judge_output_paper, all_keys = run_judge_llm_paper(\n", "    question, documents_sentences, our_response\n", ")\n", "\n", "if judge_output_paper:\n", "    our_metrics = compute_trace_metrics(judge_output_paper, all_keys)\n", "\n", "    print(\"=\" * 60)\n", "    print(\"PAPER PROMPT METRICS vs REFERENCE SCORES\")\n", "    print(\"=\" * 60)\n", "    print(f\"{'Metric':<25} {'Ours':>10} {'Reference':>12}\")\n", "    print(\"-\" * 50)\n", "    print(f\"{'Context Relevance':<25} \"\n", "          f\"{our_metrics['context_relevance']:>10.4f} \"\n", "          f\"{example['relevance_score']:>12.4f}\")\n", "    print(f\"{'Context Utilization':<25} \"\n", "          f\"{our_metrics['context_utilization']:>10.4f} \"\n", "          f\"{example['utilization_score']:>12.4f}\")\n", "    print(f\"{'Completeness':<25} \"\n", "          f\"{our_metrics['completeness']:>10.4f} \"\n", "          f\"{example['completeness_score']:>12.4f}\")\n", "    print(f\"{'Adherence':<25} \"\n", "          f\"{str(our_metrics['adherence']):>10} \"\n", "          f\"{str(example['adherence_score']):>12}\")\n", "    print()\n", "    print(\"Our relevant keys:\",\n", "          judge_output_paper.get('all_relevant_sentence_keys'))\n", "    print(\"Reference relevant keys:\",\n", "          example['all_relevant_sentence_keys'])\n", "    print()\n", "    print(\"Our utilized keys:\",\n", "          judge_output_paper.get('all_utilized_sentence_keys'))\n", "    print(\"Reference utilized keys:\",\n", "          example['all_utilized_sentence_keys'])"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "Kbq6SJ6KPzJY", "executionInfo": {"status": "ok", "timestamp": 1780721092376, "user_tz": -330, "elapsed": 1934, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "a9fdc477-34d7-4d5b-80cb-23330f417b76"}, "execution_count": 18, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Running Judge LLM with exact RAGBench paper prompt...\n", "Using llama-3.3-70b-versatile...\n", "\n", "============================================================\n", "PAPER PROMPT METRICS vs REFERENCE SCORES\n", "============================================================\n", "Metric                          Ours    Reference\n", "--------------------------------------------------\n", "Context Relevance             0.2353       0.4118\n", "Context Utilization           0.1176       0.1765\n", "Completeness                  0.5000       0.4286\n", "Adherence                      False        False\n", "\n", "Our relevant keys: ['0c', '0d', '1b', '1e']\n", "Reference relevant keys: ['0c', '0d', '1b', '1c', '1e', '2b', '2c']\n", "\n", "Our utilized keys: ['0c', '0d']\n", "Reference utilized keys: ['0c', '1b', '2b']\n"]}]}, {"cell_type": "code", "source": ["#Pass all documents to Judge LLM, as the chunks retreived are not the same as reference keys as all documnets are read\n", "def run_pipeline_full(example, embedder, client, k=3):\n", "    \"\"\"\n", "    Full pipeline for one example:\n", "    - Retrieve top-k docs for response generation\n", "    - Pass ALL docs to Judge LLM for evaluation\n", "    \"\"\"\n", "    question = example['question']\n", "    documents = example['documents']\n", "    documents_sentences = example['documents_sentences']\n", "\n", "    # Step 1: Build retriever and get top-k for response generation\n", "    index, _ = build_retriever(documents)\n", "    top_k_docs = retrieve_top_k(question, documents, index, k=k)\n", "\n", "    # Step 2: Generate response using top-k docs\n", "    our_response = generate_response(question, top_k_docs)\n", "\n", "    # Step 3: Judge LLM sees ALL documents (not just top-k)\n", "    # This is correct \u2014 relevance is judged across full context\n", "    judge_output, all_keys = run_judge_llm_paper(\n", "        question,\n", "        documents_sentences,  # ALL documents\n", "        our_response\n", "    )\n", "\n", "    if judge_output is None:\n", "        return None\n", "\n", "    # Step 4: Compute TRACe metrics\n", "    metrics = compute_trace_metrics(judge_output, all_keys)\n", "\n", "    return {\n", "        'question': question,\n", "        'our_response': our_response,\n", "        'metrics': metrics,\n", "        'judge_output': judge_output\n", "    }\n", "\n", "# Test on first example\n", "print(\"Running full pipeline on example 0...\")\n", "result = run_pipeline_full(dataset[0], embedder, client, k=3)\n", "\n", "example = dataset[0]\n", "\n", "print()\n", "print(\"=\" * 60)\n", "print(\"FULL PIPELINE METRICS vs REFERENCE SCORES\")\n", "print(\"=\" * 60)\n", "print(f\"{'Metric':<25} {'Ours':>10} {'Reference':>12}\")\n", "print(\"-\" * 50)\n", "print(f\"{'Context Relevance':<25} \"\n", "      f\"{result['metrics']['context_relevance']:>10.4f} \"\n", "      f\"{example['relevance_score']:>12.4f}\")\n", "print(f\"{'Context Utilization':<25} \"\n", "      f\"{result['metrics']['context_utilization']:>10.4f} \"\n", "      f\"{example['utilization_score']:>12.4f}\")\n", "print(f\"{'Completeness':<25} \"\n", "      f\"{result['metrics']['completeness']:>10.4f} \"\n", "      f\"{example['completeness_score']:>12.4f}\")\n", "print(f\"{'Adherence':<25} \"\n", "      f\"{str(result['metrics']['adherence']):>10} \"\n", "      f\"{str(example['adherence_score']):>12}\")\n", "print()\n", "print(\"Our relevant keys:\",\n", "      result['judge_output'].get('all_relevant_sentence_keys'))\n", "print(\"Reference relevant keys:\",\n", "      example['all_relevant_sentence_keys'])\n", "print()\n", "print(\"Our utilized keys:\",\n", "      result['judge_output'].get('all_utilized_sentence_keys'))\n", "print(\"Reference utilized keys:\",\n", "      example['all_utilized_sentence_keys'])"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "12BwiCLoQPbT", "executionInfo": {"status": "ok", "timestamp": 1780721232839, "user_tz": -330, "elapsed": 2106, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "3a589a06-1455-461c-c133-790d92098d61"}, "execution_count": 19, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Running full pipeline on example 0...\n", "\n", "============================================================\n", "FULL PIPELINE METRICS vs REFERENCE SCORES\n", "============================================================\n", "Metric                          Ours    Reference\n", "--------------------------------------------------\n", "Context Relevance             0.2353       0.4118\n", "Context Utilization           0.1176       0.1765\n", "Completeness                  0.5000       0.4286\n", "Adherence                      False        False\n", "\n", "Our relevant keys: ['0c', '0d', '1b', '1e']\n", "Reference relevant keys: ['0c', '0d', '1b', '1c', '1e', '2b', '2c']\n", "\n", "Our utilized keys: ['0c', '0d']\n", "Reference utilized keys: ['0c', '1b', '2b']\n"]}]}, {"cell_type": "code", "source": ["#Run on all 246 examples and compute RMSE + AUCROC\n", "import time\n", "import numpy as np\n", "from sklearn.metrics import roc_auc_score, mean_squared_error\n", "\n", "def run_all_examples(dataset, embedder, client, k=3,\n", "                     max_examples=None, sleep_between=2):\n", "    \"\"\"\n", "    Run full pipeline on all examples\n", "    sleep_between: seconds to wait between API calls\n", "                   to avoid Groq rate limits\n", "    \"\"\"\n", "    results = []\n", "    errors = []\n", "\n", "    n = max_examples if max_examples else len(dataset)\n", "\n", "    print(f\"Running pipeline on {n} examples...\")\n", "    print(\"This will take a while due to API rate limits.\")\n", "    print()\n", "\n", "    for i in range(n):\n", "        try:\n", "            example = dataset[i]\n", "\n", "            # Run full pipeline\n", "            result = run_pipeline_full(example, embedder, client, k=k)\n", "\n", "            if result is not None:\n", "                results.append({\n", "                    'idx': i,\n", "                    'our_relevance': result['metrics']['context_relevance'],\n", "                    'our_utilization': result['metrics']['context_utilization'],\n", "                    'our_completeness': result['metrics']['completeness'],\n", "                    'our_adherence': result['metrics']['adherence'],\n", "                    'ref_relevance': example['relevance_score'],\n", "                    'ref_utilization': example['utilization_score'],\n", "                    'ref_completeness': example['completeness_score'],\n", "                    'ref_adherence': example['adherence_score'],\n", "                })\n", "\n", "                if (i + 1) % 10 == 0:\n", "                    print(f\"  Completed {i+1}/{n} examples...\")\n", "            else:\n", "                errors.append(i)\n", "                print(f\"  \u26a0\ufe0f Example {i} failed - skipping\")\n", "\n", "        except Exception as e:\n", "            errors.append(i)\n", "            print(f\"  \u26a0\ufe0f Example {i} error: {str(e)[:80]}\")\n", "\n", "        # Sleep to avoid Groq rate limits\n", "        time.sleep(sleep_between)\n", "\n", "    print(f\"\\n\u2705 Done! {len(results)} succeeded, {len(errors)} failed\")\n", "    return results, errors\n", "\n", "def compute_final_scores(results):\n", "    \"\"\"\n", "    Compute RMSE and AUCROC from results\n", "    \"\"\"\n", "    our_relevance    = [r['our_relevance']    for r in results]\n", "    our_utilization  = [r['our_utilization']  for r in results]\n", "    our_completeness = [r['our_completeness'] for r in results]\n", "    our_adherence    = [r['our_adherence']    for r in results]\n", "\n", "    ref_relevance    = [r['ref_relevance']    for r in results]\n", "    ref_utilization  = [r['ref_utilization']  for r in results]\n", "    ref_completeness = [r['ref_completeness'] for r in results]\n", "    ref_adherence    = [r['ref_adherence']    for r in results]\n", "\n", "    # RMSE for continuous metrics\n", "    rmse_relevance = np.sqrt(mean_squared_error(\n", "        ref_relevance, our_relevance))\n", "    rmse_utilization = np.sqrt(mean_squared_error(\n", "        ref_utilization, our_utilization))\n", "    rmse_completeness = np.sqrt(mean_squared_error(\n", "        ref_completeness, our_completeness))\n", "\n", "    # AUCROC for adherence (binary)\n", "    # Convert boolean to int\n", "    our_adherence_int = [1 if a else 0 for a in our_adherence]\n", "    ref_adherence_int = [1 if a else 0 for a in ref_adherence]\n", "\n", "    try:\n", "        aucroc = roc_auc_score(ref_adherence_int, our_adherence_int)\n", "    except ValueError:\n", "        aucroc = 0.5\n", "        print(\"Note: AUCROC could not be computed - \"\n", "              \"only one class in reference\")\n", "\n", "    print()\n", "    print(\"=\" * 60)\n", "    print(\"FINAL RESULTS \u2014 RAGBench CovidQA (test split)\")\n", "    print(\"=\" * 60)\n", "    print(f\"{'Metric':<25} {'RMSE / AUCROC':>15}\")\n", "    print(\"-\" * 45)\n", "    print(f\"{'Context Relevance (RMSE)':<25} {rmse_relevance:>15.4f}\")\n", "    print(f\"{'Context Utilization (RMSE)':<25} {rmse_utilization:>15.4f}\")\n", "    print(f\"{'Completeness (RMSE)':<25} {rmse_completeness:>15.4f}\")\n", "    print(f\"{'Adherence (AUCROC)':<25} {aucroc:>15.4f}\")\n", "    print()\n", "    print(\"Reference RMSE from paper (GPT-3.5 judge):\")\n", "    print(\"  Context Relevance:   0.18\")\n", "    print(\"  Context Utilization: 0.11\")\n", "    print(\"  Adherence AUCROC:    0.57\")\n", "\n", "    return {\n", "        'rmse_relevance':    rmse_relevance,\n", "        'rmse_utilization':  rmse_utilization,\n", "        'rmse_completeness': rmse_completeness,\n", "        'aucroc_adherence':  aucroc\n", "    }\n", "\n", "# First test on 5 examples to make sure everything works\n", "# Then we run all 246\n", "print(\"Testing on first 5 examples first...\")\n", "test_results, test_errors = run_all_examples(\n", "    dataset, embedder, client,\n", "    k=3,\n", "    max_examples=5,\n", "    sleep_between=3\n", ")\n", "\n", "if len(test_results) >= 3:\n", "    print()\n", "    print(\"Test run successful! Here are scores for 5 examples:\")\n", "    scores = compute_final_scores(test_results)\n", "    print()\n", "    print(\"\u2705 Ready to run on all 246 examples.\")\n", "    print(\"Run the next cell to start the full run.\")\n", "else:\n", "    print(\"\u26a0\ufe0f Test run had too many errors. Check above.\")"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "hTsaRaXCQrAC", "executionInfo": {"status": "ok", "timestamp": 1780721330295, "user_tz": -330, "elapsed": 20911, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "3afa3b36-01ae-4adb-a92f-43050946a057"}, "execution_count": 20, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["Testing on first 5 examples first...\n", "Running pipeline on 5 examples...\n", "This will take a while due to API rate limits.\n", "\n", "\n", "\u2705 Done! 5 succeeded, 0 failed\n", "\n", "Test run successful! Here are scores for 5 examples:\n", "\n", "============================================================\n", "FINAL RESULTS \u2014 RAGBench CovidQA (test split)\n", "============================================================\n", "Metric                      RMSE / AUCROC\n", "---------------------------------------------\n", "Context Relevance (RMSE)           0.3003\n", "Context Utilization (RMSE)          0.1161\n", "Completeness (RMSE)                0.6656\n", "Adherence (AUCROC)                 0.8750\n", "\n", "Reference RMSE from paper (GPT-3.5 judge):\n", "  Context Relevance:   0.18\n", "  Context Utilization: 0.11\n", "  Adherence AUCROC:    0.57\n", "\n", "\u2705 Ready to run on all 246 examples.\n", "Run the next cell to start the full run.\n"]}]}, {"cell_type": "code", "source": ["#Full run on all 246 examples\n", "import os\n", "\n", "# Create local results folder in Colab\n", "os.makedirs('/content/results', exist_ok=True)\n", "print(\"\u2705 Results folder created at /content/results\")\n", "print(\"We will download results at the end of the run.\")"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "BP5omZXARWJB", "executionInfo": {"status": "ok", "timestamp": 1780721681115, "user_tz": -330, "elapsed": 50, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "0fed0c31-1c8b-4720-b14d-369d1c862f3d"}, "execution_count": 23, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["\u2705 Results folder created at /content/results\n", "We will download results at the end of the run.\n"]}]}, {"cell_type": "code", "source": ["#Run for akk 246 samples\n", "import json\n", "import time\n", "import numpy as np\n", "import pandas as pd\n", "from sklearn.metrics import roc_auc_score, mean_squared_error\n", "\n", "def run_pipeline_with_retry(example, embedder, client, k=3,\n", "                             max_retries=3):\n", "    \"\"\"\n", "    Run pipeline with automatic retry on rate limit errors\n", "    \"\"\"\n", "    question = example['question']\n", "    documents = example['documents']\n", "    documents_sentences = example['documents_sentences']\n", "\n", "    # Step 1: Retrieve top-k docs\n", "    index, _ = build_retriever(documents)\n", "    top_k_docs = retrieve_top_k(question, documents, index, k=k)\n", "\n", "    # Step 2: Generate response \u2014 with retry\n", "    our_response = None\n", "    for attempt in range(max_retries):\n", "        try:\n", "            our_response = generate_response(question, top_k_docs)\n", "            break\n", "        except Exception as e:\n", "            if '429' in str(e):\n", "                wait = (attempt + 1) * 15\n", "                print(f\"    Rate limit on generator. \"\n", "                      f\"Waiting {wait}s...\")\n", "                time.sleep(wait)\n", "            else:\n", "                raise e\n", "\n", "    if our_response is None:\n", "        return None\n", "\n", "    # Step 3: Judge LLM \u2014 with retry\n", "    judge_output = None\n", "    all_keys = None\n", "    for attempt in range(max_retries):\n", "        try:\n", "            judge_output, all_keys = run_judge_llm_paper(\n", "                question, documents_sentences, our_response\n", "            )\n", "            break\n", "        except Exception as e:\n", "            if '429' in str(e):\n", "                wait = (attempt + 1) * 20\n", "                print(f\"    Rate limit on judge. \"\n", "                      f\"Waiting {wait}s...\")\n", "                time.sleep(wait)\n", "            else:\n", "                raise e\n", "\n", "    if judge_output is None:\n", "        return None\n", "\n", "    # Step 4: Compute metrics\n", "    metrics = compute_trace_metrics(judge_output, all_keys)\n", "\n", "    return {\n", "        'question': question,\n", "        'our_response': our_response,\n", "        'metrics': metrics,\n", "        'judge_output': judge_output\n", "    }\n", "\n", "# Load previously saved progress\n", "import os\n", "\n", "progress_file = '/content/results/ragbench_results_progress.csv'\n", "\n", "if os.path.exists(progress_file):\n", "    df_existing = pd.read_csv(progress_file)\n", "    all_results = df_existing.to_dict('records')\n", "    completed_indices = set(df_existing['idx'].tolist())\n", "    print(f\"\u2705 Loaded {len(all_results)} existing results\")\n", "    print(f\"   Resuming from where we left off...\")\n", "else:\n", "    all_results = []\n", "    completed_indices = set()\n", "    print(\"Starting fresh...\")\n", "\n", "all_errors = []\n", "\n", "print(f\"Examples remaining: {246 - len(completed_indices)}\")\n", "print()\n", "\n", "for i in range(len(dataset)):\n", "\n", "    # Skip already completed examples\n", "    if i in completed_indices:\n", "        continue\n", "\n", "    try:\n", "        example = dataset[i]\n", "        result = run_pipeline_with_retry(\n", "            example, embedder, client, k=3\n", "        )\n", "\n", "        if result is not None:\n", "            all_results.append({\n", "                'idx':              i,\n", "                'question':         example['question'][:100],\n", "                'our_relevance':    result['metrics']['context_relevance'],\n", "                'our_utilization':  result['metrics']['context_utilization'],\n", "                'our_completeness': result['metrics']['completeness'],\n", "                'our_adherence':    1 if result['metrics']['adherence'] else 0,\n", "                'ref_relevance':    example['relevance_score'],\n", "                'ref_utilization':  example['utilization_score'],\n", "                'ref_completeness': example['completeness_score'],\n", "                'ref_adherence':    1 if example['adherence_score'] else 0,\n", "            })\n", "            completed_indices.add(i)\n", "        else:\n", "            all_errors.append(i)\n", "\n", "    except Exception as e:\n", "        all_errors.append(i)\n", "        print(f\"\u26a0\ufe0f Example {i} failed: {str(e)[:80]}\")\n", "\n", "    # Save progress every 10 examples\n", "    if len(all_results) % 10 == 0 and len(all_results) > 0:\n", "        df_temp = pd.DataFrame(all_results)\n", "        df_temp.to_csv(progress_file, index=False)\n", "        print(f\"\ud83d\udcbe Progress saved \u2014 \"\n", "              f\"{len(all_results)}/246 completed\")\n", "\n", "    # Longer sleep \u2014 6 seconds between calls\n", "    # to stay well under rate limits\n", "    time.sleep(6)\n", "\n", "# Save final results\n", "df_results = pd.DataFrame(all_results)\n", "df_results.to_csv(\n", "    '/content/results/ragbench_results_final.csv',\n", "    index=False\n", ")\n", "\n", "print()\n", "print(f\"\u2705 Run complete!\")\n", "print(f\"   Succeeded: {len(all_results)}\")\n", "print(f\"   Failed:    {len(all_errors)}\")\n", "print(f\"   Saved to:  /content/results/ragbench_results_final.csv\")"], "metadata": {"colab": {"base_uri": "https://localhost:8080/", "height": 790}, "id": "Pugq9cnxSOqK", "executionInfo": {"status": "error", "timestamp": 1780722834191, "user_tz": -330, "elapsed": 489145, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "40eb36ee-b2ed-47ff-db36-eddc2fa413b4"}, "execution_count": 26, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["\u2705 Loaded 50 existing results\n", "   Resuming from where we left off...\n", "Examples remaining: 196\n", "\n", "    Rate limit on judge. Waiting 20s...\n", "    Rate limit on judge. Waiting 40s...\n", "    Rate limit on judge. Waiting 60s...\n", "\ud83d\udcbe Progress saved \u2014 50/246 completed\n", "    Rate limit on judge. Waiting 20s...\n", "    Rate limit on judge. Waiting 40s...\n", "    Rate limit on judge. Waiting 60s...\n", "\ud83d\udcbe Progress saved \u2014 50/246 completed\n", "    Rate limit on judge. Waiting 20s...\n", "    Rate limit on judge. Waiting 40s...\n", "    Rate limit on judge. Waiting 60s...\n", "\ud83d\udcbe Progress saved \u2014 50/246 completed\n", "    Rate limit on judge. Waiting 20s...\n", "    Rate limit on judge. Waiting 40s...\n", "    Rate limit on judge. Waiting 60s...\n"]}, {"output_type": "error", "ename": "KeyboardInterrupt", "evalue": "", "traceback": ["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m", "\u001b[0;31mRateLimitError\u001b[0m                            Traceback (most recent call last)", "\u001b[0;32m/tmp/ipykernel_843/826218580.py\u001b[0m in \u001b[0;36mrun_pipeline_with_retry\u001b[0;34m(example, embedder, client, k, max_retries)\u001b[0m\n\u001b[1;32m     43\u001b[0m         \u001b[0;32mtry\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 44\u001b[0;31m    