 as pd\n", "import numpy as np\n", "\n", "# Key rotation variables\n", "current_key_index = 0\n", "\n", "def get_rotated_client():\n", "    \"\"\"Get current active Groq client\"\"\"\n", "    from groq import Groq\n", "    return Groq(api_key=GROQ_KEYS[current_key_index])\n", "\n", "def rotate_key():\n", "    \"\"\"Switch to next key automatically\"\"\"\n", "    global current_key_index\n", "    current_key_index = (current_key_index + 1) % len(GROQ_KEYS)\n", "    print(f\"    \ud83d\udd04 Switched to key {current_key_index + 1}\")\n", "    return get_rotated_client()\n", "\n", "def generate_response_rotated(question, retrieved_docs):\n", "    \"\"\"Generate response with key rotation\"\"\"\n", "    global current_key_index\n", "\n", "    context = \"\\n\\n\".join([f\"Document {i+1}:\\n{doc}\"\n", "                           for i, doc in enumerate(retrieved_docs)])\n", "\n", "    prompt = f\"\"\"Use the following pieces of context to answer the question.\n", "{context}\n", "Question: {question}\"\"\"\n", "\n", "    for attempt in range(len(GROQ_KEYS) + 1):\n", "        try:\n", "            active_client = get_rotated_client()\n", "            response = active_client.chat.completions.create(\n", "                model=\"llama-3.1-8b-instant\",\n", "                messages=[{\"role\": \"user\", \"content\": prompt}],\n", "                max_tokens=256,\n", "                temperature=0\n", "            )\n", "            return response.choices[0].message.content.strip()\n", "        except Exception as e:\n", "            if '429' in str(e):\n", "                rotate_key()\n", "                time.sleep(5)\n", "            else:\n", "                raise e\n", "    return None\n", "\n", "def run_judge_rotated(question, documents_sentences, response):\n", "    \"\"\"Run Judge LLM with key rotation\"\"\"\n", "    global current_key_index\n", "\n", "    formatted_docs = format_documents_with_keys(documents_sentences)\n", "    formatted_response, _ = format_response_with_keys(response)\n", "\n", "    all_sentence_keys = []\n", "    for doc_sentences in documents_sentences:\n", "        for key, sentence in doc_sentences:\n", "            all_sentence_keys.append(key)\n", "\n", "    prompt = f\"\"\"I asked someone to answer a question based on one or more documents.\n", "Your task is to review their response and assess whether or not each sentence\n", "in that response is supported by text in the documents. And if so, which\n", "sentences in the documents provide that support. You will also tell me which\n", "of the documents contain useful information for answering the question, and\n", "which of the documents the answer was sourced from.\n", "\n", "Here are the documents, each of which is split into sentences. Alongside each\n", "sentence is associated key, such as '0a.' or '0b.' that you can use to refer\n", "to it:\n", "'''\n", "{formatted_docs}\n", "'''\n", "\n", "The question was:\n", "'''\n", "{question}\n", "'''\n", "\n", "Here is their response, split into sentences. Alongside each sentence is\n", "associated key, such as 'a.' or 'b.' that you can use to refer to it. Note\n", "that these keys are unique to the response, and are not related to the keys\n", "in the documents:\n", "'''\n", "{formatted_response}\n", "'''\n", "\n", "You must respond with a JSON object matching this schema:\n", "'''\n", "{{\n", "\"relevance_explanation\": string,\n", "\"all_relevant_sentence_keys\": [string],\n", "\"overall_supported_explanation\": string,\n", "\"overall_supported\": boolean,\n", "\"sentence_support_information\": [\n", "{{\n", "\"response_sentence_key\": string,\n", "\"explanation\": string,\n", "\"supporting_sentence_keys\": [string],\n", "\"fully_supported\": boolean\n", "}}\n", "],\n", "\"all_utilized_sentence_keys\": [string]\n", "}}\n", "'''\n", "\n", "The all_relevant_sentence_keys field is a list of all document sentence keys\n", "that are relevant to the question. Ignore the response when making this\n", "judgement. Only include sentences that directly help answer the question.\n", "\n", "The all_utilized_sentence_keys field is a list of document sentence keys\n", "whose specific content was used to construct the answer.\n", "\n", "The overall_supported field is true only if ALL response sentences are\n", "fully supported by the documents.\n", "\n", "Return ONLY valid JSON. No markdown, no extra text.\"\"\"\n", "\n", "    for attempt in range(len(GROQ_KEYS) + 1):\n", "        try:\n", "            active_client = get_rotated_client()\n", "            response_judge = active_client.chat.completions.create(\n", "                model=\"llama-3.1-8b-instant\",\n", "                messages=[{\"role\": \"user\", \"content\": prompt}],\n", "                max_tokens=2048,\n", "                temperature=0\n", "            )\n", "\n", "            raw = response_judge.choices[0].message.content.strip()\n", "\n", "            if \"```json\" in raw:\n", "                raw = raw.split(\"```json\")[1].split(\"```\")[0].strip()\n", "            elif \"```\" in raw:\n", "                raw = raw.split(\"```\")[1].split(\"```\")[0].strip()\n", "\n", "            result = json.loads(raw)\n", "            return result, all_sentence_keys\n", "\n", "        except Exception as e:\n", "            if '429' in str(e):\n", "                rotate_key()\n", "                time.sleep(5)\n", "            else:\n", "                print(f\"    Non-rate-limit error: {str(e)[:60]}\")\n", "                return None, all_sentence_keys\n", "\n", "    return None, all_sentence_keys\n", "\n", "def run_pipeline_rotated(example, embedder, k=3):\n", "    \"\"\"Full pipeline with key rotation\"\"\"\n", "    question = example['question']\n", "    documents = example['documents']\n", "    documents_sentences = example['documents_sentences']\n", "\n", "    # Retrieve\n", "    index, _ = build_retriever(documents)\n", "    top_k_docs = retrieve_top_k(question, documents, index, k=k)\n", "\n", "    # Generate\n", "    our_response = generate_response_rotated(question, top_k_docs)\n", "    if our_response is None:\n", "        return None\n", "\n", "    # Judge\n", "    judge_output, all_keys = run_judge_rotated(\n", "        question, documents_sentences, our_response\n", "    )\n", "    if judge_output is None:\n", "        return None\n", "\n", "    # Metrics\n", "    metrics = compute_trace_metrics(judge_output, all_keys)\n", "\n", "    return {\n", "        'question':     question,\n", "        'our_response': our_response,\n", "        'metrics':      metrics\n", "    }\n", "\n", "# Load existing progress\n", "progress_file = '/content/results/ragbench_results_progress.csv'\n", "df_existing = pd.read_csv(progress_file)\n", "all_results = df_existing.to_dict('records')\n", "completed_indices = set(df_existing['idx'].tolist())\n", "\n", "print(f\"\u2705 Loaded {len(all_results)} existing results\")\n", "print(f\"   Remaining: {246 - len(completed_indices)} examples\")\n", "print(f\"   Using 3 keys with automatic rotation\")\n", "print()\n", "\n", "all_errors = []\n", "\n", "for i in range(len(dataset)):\n", "\n", "    if i in completed_indices:\n", "        continue\n", "\n", "    try:\n", "        example = dataset[i]\n", "        result = run_pipeline_rotated(example, embedder, k=3)\n", "\n", "        if result is not None:\n", "            all_results.append({\n", "                'idx':              i,\n", "                'question':         example['question'][:100],\n", "                'our_relevance':    result['metrics']['context_relevance'],\n", "                'our_utilization':  result['metrics']['context_utilization'],\n", "                'our_completeness': result['metrics']['completeness'],\n", "                'our_adherence':    1 if result['metrics']['adherence'] else 0,\n", "                'ref_relevance':    example['relevance_score'],\n", "                'ref_utilization':  example['utilization_score'],\n", "                'ref_completeness': example['completeness_score'],\n", "                'ref_adherence':    1 if example['adherence_score'] else 0,\n", "            })\n", "            completed_indices.add(i)\n", "        else:\n", "            all_errors.append(i)\n", "\n", "    except Exception as e:\n", "        all_errors.append(i)\n", "        print(f\"\u26a0\ufe0f Example {i} failed: {str(e)[:80]}\")\n", "\n", "    # Save every 10 examples\n", "    if len(all_results) % 10 == 0:\n", "        df_temp = pd.DataFrame(all_results)\n", "        df_temp.to_csv(progress_file, index=False)\n", "        print(f\"\ud83d\udcbe {len(all_results)}/246 completed... \"\n", "              f\"(active key: {current_key_index + 1})\")\n", "\n", "    # 4 seconds sleep\n", "    time.sleep(4)\n", "\n", "# Save final\n", "df_final = pd.DataFrame(all_results)\n", "df_final.to_csv(\n", "    '/content/results/ragbench_results_final.csv',\n", "    index=False\n", ")\n", "\n", "print()\n", "print(f\"\u2705 Run complete!\")\n", "print(f\"   Succeeded: {len(all_results)}\")\n", "print(f\"   Failed:    {len(all_errors)}\")\n", "print(f\"   Saved to:  /content/results/ragbench_results_final.csv\")"], "metadata": {"colab": {"base_uri": "https://localhost:8080/"}, "id": "fKUW3Jh9fOHt", "executionInfo": {"status": "ok", "timestamp": 1780727639254, "user_tz": -330, "elapsed": 1916815, "user": {"displayName": "Veenu Dandekar", "userId": "11147265895979726155"}}, "outputId": "23d5ee7f-b1a4-4681-c858-aa5d3fa7ea7e"}, "execution_count": 32, "outputs": [{"output_type": "stream", "name": "stdout", "text": ["\u2705 Loaded 160 existing results\n", "   Remaining: 86 examples\n", "   Using 3 keys with automatic rotation\n", "\n", "\ud83d\udcbe 170/246 completed... (active key: 1)\n", "\ud83d\udcbe 180/246 completed... (active key: 1)\n", "    \ud83d\udd04 Switched to key 2\n", "\ud83d\udcbe 190/246 completed... (active key: 2)\n", "    \ud83d\udd04 Switched to key 3\n", "\ud83d\udcbe 200/246 completed... (active key: 3)\n", " 